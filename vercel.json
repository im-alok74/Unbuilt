{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/scan/route.ts": { "maxDuration": 60 },
    "app/api/sites/route.ts": { "maxDuration": 60 },
    "app/api/sites/[id]/generate/route.ts": { "maxDuration": 60 },
    "app/api/leads/[id]/pitch/route.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/digest", "schedule": "30 3 * * *" }]
}
