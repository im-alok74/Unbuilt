# ─── Database (Supabase) ─────────────────────────────────────────────────────────
# Supavisor transaction pooler string (port 6543) from Project Settings → Database
# → Connection string → "Transaction pooler". Serverless-friendly, no prepared
# statements required.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Optional. Supabase's root CA is bundled (lib/db/supabase-ca.ts) and TLS is always verified;
# set this to a PEM to use a different CA.
DATABASE_CA=""

# ─── Secrets (generated once, never commit real values) ─────────────────────────
# 32-byte base64. Encrypts API keys stored in the settings table.
ENCRYPTION_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
# 32-byte base64. Signs the login session cookie.
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# ─── First-run admin ───────────────────────────────────────────────────────────
# Used only while the users table is empty: the first login with these creates the admin.
# (If ADMIN_PASSWORD is unset it falls back to APP_PIN.) Change it under You -> Account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
APP_PIN=""

# ─── Push notifications + daily digest ─────────────────────────────────────────
# Generate keys once: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Vercel Cron sends this as a Bearer token to /api/cron/digest.
CRON_SECRET=""

# ─── Map (Mapbox) ──────────────────────────────────────────────────────────────
# Public token (pk.*). Safe to expose to the browser; restrict it by URL in the
# Mapbox dashboard. Can also be set later in the You tab instead of here.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ─── Optional key overrides ────────────────────────────────────────────────────
# The You tab is the primary place to configure these. Env vars here win if set.
GOOGLE_PLACES_API_KEY=""
GEMINI_API_KEY=""
